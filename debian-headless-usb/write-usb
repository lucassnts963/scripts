#!/usr/bin/env bash
# Grava o ISO remasterizado (gerado pelo ./build-iso) direto no pendrive — dd puro, sem
# Ventoy. Apaga TUDO que tiver no pendrive, incluindo o Ventoy configurado antes.
set -euo pipefail

ISO="$(dirname "$(readlink -f "$0")")/debian-13.6.0-headless-autoinstall.iso"
DEV="${1:-}"

[ -f "$ISO" ] || { echo "ISO não encontrada: $ISO — roda ./build-iso primeiro." >&2; exit 1; }

if [ -z "$DEV" ]; then
    echo "Uso: sudo ./write-usb /dev/sdX" >&2
    echo >&2
    echo "Dispositivos disponíveis:" >&2
    lsblk -o NAME,SIZE,TYPE,TRAN,MODEL >&2
    exit 1
fi

if [ "$(id -u)" -ne 0 ]; then
    echo "Precisa rodar com sudo (escreve direto no disco)." >&2
    exit 1
fi

echo "Isso vai APAGAR TUDO em $DEV:"
lsblk -o NAME,SIZE,TYPE,TRAN,MODEL "$DEV"
read -r -p "Confirma? Digite 'sim' pra continuar: " CONFIRMA
[ "$CONFIRMA" = "sim" ] || { echo "Cancelado."; exit 1; }

dd if="$ISO" of="$DEV" bs=4M status=progress conv=fsync
sync

echo
echo "Gravado. Pode desconectar o pendrive com segurança."
